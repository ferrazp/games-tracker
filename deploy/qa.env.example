# Ambiente: qa. Copiar a deploy/qa.env (NO se commitea) y completar.
# Generar secretos con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# Imagen a levantar (los scripts la sobreescriben con --tag / la versión)
IMAGE_TAG=main
FRONT_PORT=8081
FRONTEND_URL=http://localhost:8081

# Volumen de datos de Postgres
DB_VOLUME=gt-qa_db_data

# Postgres (el mismo usuario lo usan el contenedor db y el backend)
DB_USER=gt_qa
DB_PASSWORD=
DB_NAME=games_tracker

# Auth: obligatorios y fuertes (NODE_ENV=production rechaza los débiles)
JWT_SECRET=
ADMIN_USER=admin
ADMIN_PASS=

# IGDB / Twitch (opcional: sin esto no anda la búsqueda online)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

LOG_LEVEL=info
