{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "games-tracker",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "apps/backend/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/frontend/package.json",
          "jsonpath": "$.version"
        }
      ],
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Funcionalidades"
        },
        {
          "type": "fix",
          "section": "Correcciones"
        },
        {
          "type": "perf",
          "section": "Rendimiento"
        },
        {
          "type": "revert",
          "section": "Reversiones"
        },
        {
          "type": "docs",
          "section": "Documentación",
          "hidden": true
        },
        {
          "type": "chore",
          "section": "Mantenimiento",
          "hidden": true
        },
        {
          "type": "refactor",
          "section": "Refactor",
          "hidden": true
        },
        {
          "type": "test",
          "section": "Tests",
          "hidden": true
        },
        {
          "type": "ci",
          "section": "CI",
          "hidden": true
        },
        {
          "type": "build",
          "section": "Build",
          "hidden": true
        }
      ]
    }
  }
}
