# Twitch API Credentials (OPCIONAL - búsqueda local funciona igual)
TWITCH_CLIENT_ID=your_client_id_here
TWITCH_CLIENT_SECRET=your_client_secret_here

# Auth (OBLIGATORIO en producción: el backend no arranca con NODE_ENV=production si faltan)
# JWT_SECRET: mínimo 32 caracteres. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ADMIN_USER=admin
# ADMIN_PASS: no puede ser "1234" en producción
ADMIN_PASS=

# Server Configuration
PORT=4000
NODE_ENV=development

# Database Type: sqlite (default) or postgresql
DB_TYPE=sqlite

# Frontend URL (for CORS)
# - Dev local (SQLite): http://localhost:3000
# - Dev Docker:         http://localhost:3001
# - Prod Docker:        http://localhost:9090
FRONTEND_URL=http://localhost:3000

# PostgreSQL Configuration (only used if DB_TYPE=postgresql)
# En Docker estos valores se configuran dentro del docker-compose correspondiente
DB_HOST=postgres
DB_PORT=5432
DB_NAME=games_tracker
DB_USER=postgres
DB_PASSWORD=postgres

# Log Level (debug | info | warn | error)
LOG_LEVEL=debug
